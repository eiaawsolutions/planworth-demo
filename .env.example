# ─────────────────────────────────────────────────────────────
# Planworth Intelligent Ecosystem demo — environment
#
# EIAAW house default is MODE A: the only raw secrets in env are the three
# Infisical bootstrap creds. Every other secret is a `secret://` handle that
# src/lib/secrets.ts resolves at runtime.
#
#   MODE A (default, below)  INFISICAL_RESOLVER_ENABLED=true, ANTHROPIC_API_KEY
#                            is a secret:// handle. Nothing sensitive is ever
#                            pasted into Railway beyond the bootstrap creds.
#
#   MODE B (override only)   INFISICAL_RESOLVER_ENABLED=false and a plain
#                            sk-ant-... value in ANTHROPIC_API_KEY. This is a
#                            DELIBERATE EXCEPTION for a throwaway demo and needs
#                            an explicit decision — it is not the default. If you
#                            use it, rotate the key when the demo is retired.
#
# Never commit a resolved value. .env is gitignored; this file is the template.
# ─────────────────────────────────────────────────────────────

# ── Infisical bootstrap (the ONLY raw secrets that belong in env) ──
INFISICAL_RESOLVER_ENABLED=true
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_APP_CLIENT_ID=
INFISICAL_APP_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_CACHE_TTL=300
INFISICAL_REQUEST_TIMEOUT=5

# ── Anthropic — SERVER-ONLY. Never prefix with NEXT_PUBLIC_. ──
# Mode A (default): a handle, resolved by src/lib/secrets.ts at runtime.
# Mode B (override): a plain sk-ant-... value, with the resolver disabled above.
ANTHROPIC_API_KEY=secret://planworth-demo-prod/prod/ANTHROPIC_API_KEY

# ── Postgres ──
# Local: a dedicated demo database (see README for the docker one-liner).
# Railway: reference the Postgres plugin — ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://planworth:planworth_demo_pw@localhost:5434/planworth_demo?schema=public"

# ── Non-secret demo config ──
# Shown in the workspace header so the audience knows whose seat they're in.
DEMO_OPERATOR="Nurul Huda binti Ismail · Credit Operations"
